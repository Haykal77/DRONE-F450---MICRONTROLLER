/**
 * SLAVE CODE: Unified Roll/Pitch PID & Corrected Mixer
 */

#include <esp_now.h>
#include <WiFi.h>
#include <Wire.h>
#include <Arduino.h>
#include <driver/ledc.h>
#include <soc/ledc_struct.h>

// ================================================================
// 1. STRUKTUR PID & PESAN
// ================================================================
struct PIDController {
    float Kp, Ki, Kd;
    float integral, prev_error, output_limit;

    PIDController(float p, float i, float d, float limit) {
        Kp = p; Ki = i; Kd = d; output_limit = limit;
        integral = 0.0; prev_error = 0.0;
    }

    float compute(float error, float dt) {
        if (dt <= 0.0f) return 0.0f;
        integral += (error + prev_error) * 0.5f * dt;
        integral = constrain(integral, -output_limit, output_limit);
        float derivative = (error - prev_error) / dt;
        prev_error = error;
        float output = (Kp * error) + (Ki * integral) + (Kd * derivative);
        return constrain(output, -output_limit, output_limit);
    }
    void reset() { integral = 0.0; prev_error = 0.0; }
};

uint8_t masterAddress[] = {0x10, 0x51, 0xDB, 0x7E, 0x82, 0x78};

enum MessageType { TELEMETRY_DATA = 1, PID_UPDATE = 2 };

typedef struct struct_message {
    uint8_t msgType; 
    uint8_t padding[3]; // Mencegah memory mismatch
    
    int throttle;
    int motor1; int motor2; int motor3; int motor4;
    int rx1; int rx2; int rx3; int rx4;
    float roll; float pitch;
    
    float P_Angle, I_Angle, D_Angle;
    float P_Rate, I_Rate, D_Rate;
    float P_Yaw, I_Yaw, D_Yaw;
} struct_message;

struct_message myData;
esp_now_peer_info_t peerInfo;

// ================================================================
// 2. INSTANSIASI PID (Nilai Default Aman untuk Hover)
// ================================================================
// Angle PID (Batas 200 deg/s) - P diturunkan agar stik lebih kalem
PIDController pidAngleRoll(3.0, 0.05, 0.015, 200.0);  
PIDController pidAnglePitch(3.0, 0.05, 0.015, 200.0); 

// Rate PID (Batas 150) - P diturunkan, D diberi redaman sedikit
PIDController pidRateRoll(2, 0.1, 0.025, 200.0);   
PIDController pidRatePitch(2, 0.1, 0.025, 200.0);  
PIDController pidRateYaw(1.5, 0.0, 0.05, 200.0);       

// ================================================================
// 3. HARDWARE & VARIABEL
// ================================================================
const int PWM_PIN_M1 = 13; const int PWM_PIN_M2 = 4;  
const int PWM_PIN_M3 = 14; const int PWM_PIN_M4 = 27; 
const int channel_pins[6] = {19, 18, 32, 33, 25, 26}; 

uint32_t current_time;
volatile uint32_t last_channel[6] = {0,0,0,0,0,0};
volatile uint32_t timer[6] = {0,0,0,0,0,0};
volatile int ReceiverValue[6] = {1500, 1500, 1000, 1500, 1000, 1000}; 

volatile float MotorInput1=1000, MotorInput2=1000, MotorInput3=1000, MotorInput4=1000;
volatile float InputThrottle=1000;

float RateRoll, RatePitch, RateYaw;
float RateCalibrationRoll, RateCalibrationPitch, RateCalibrationYaw;
float AccXCalibration, AccYCalibration, AccZCalibration; 
float AccX, AccY, AccZ, AngleRoll, AnglePitch;
float KalmanAngleRoll=0, KalmanUncertaintyAngleRoll=4;
float KalmanAnglePitch=0, KalmanUncertaintyAnglePitch=4;
float Kalman1DOutput[]={0,0};
float DesiredRateRoll=0, DesiredRatePitch=0, DesiredRateYaw=0;

// ================================================================
// 4. INTERRUPT & ESP-NOW
// ================================================================
void OnDataSent(const uint8_t *mac_addr, esp_now_send_status_t status) {}

void OnDataRecv(const esp_now_recv_info_t * info, const uint8_t *incomingData, int len) {
    if (incomingData[0] == PID_UPDATE) {
        // Cek ukuran secara langsung di Serial Monitor
        if (len != sizeof(struct_message)) {
            Serial.printf("\n[DITOLAK] Ukuran meleset! Diterima: %d bytes, Seharusnya: %d bytes\n", len, sizeof(struct_message));
            return; // Buang pesan
        }
        
        // 2. Jika lolos validasi, terapkan pembaruan
        struct_message incoming;
        memcpy(&incoming, incomingData, sizeof(incoming));
        
        pidAngleRoll.Kp = incoming.P_Angle; pidAnglePitch.Kp = incoming.P_Angle;
        pidAngleRoll.Ki = incoming.I_Angle; pidAnglePitch.Ki = incoming.I_Angle;
        pidAngleRoll.Kd = incoming.D_Angle; pidAnglePitch.Kd = incoming.D_Angle;
        
        pidRateRoll.Kp  = incoming.P_Rate;  pidRatePitch.Kp  = incoming.P_Rate;
        pidRateRoll.Ki  = incoming.I_Rate;  pidRatePitch.Ki  = incoming.I_Rate;
        pidRateRoll.Kd  = incoming.D_Rate;  pidRatePitch.Kd  = incoming.D_Rate;
        
        pidRateYaw.Kp   = incoming.P_Yaw;   pidRateYaw.Ki    = incoming.I_Yaw;   
        pidRateYaw.Kd   = incoming.D_Yaw;
        
        digitalWrite(2, !digitalRead(2));
        Serial.println("\n[BERHASIL] Parameter PID Drone telah diperbarui!");
    }
}

void IRAM_ATTR channelInterruptHandler() {
    current_time = micros();
    for(int i=0; i<6; i++) {
        if (digitalRead(channel_pins[i])) {
            if (last_channel[i] == 0) { last_channel[i] = 1; timer[i] = current_time; }
        } else if (last_channel[i] == 1) {
            last_channel[i] = 0;
            long input_pulse = current_time - timer[i];
            if (input_pulse > 900 && input_pulse < 2100) ReceiverValue[i] = input_pulse;
        }
    }
}

// ================================================================
// 5. SENSOR & HARDWARE PWM
// ================================================================
void kalman_1d(float KalmanState, float KalmanUncertainty, float KalmanInput, float KalmanMeasurement) {
    KalmanState = KalmanState + 0.004f * KalmanInput;
    KalmanUncertainty = KalmanUncertainty + 0.004f * 0.004f * 16.0f;
    float KalmanGain = KalmanUncertainty / (KalmanUncertainty + 9.0f);
    KalmanState = KalmanState + KalmanGain * (KalmanMeasurement - KalmanState);
    KalmanUncertainty = (1.0f - KalmanGain) * KalmanUncertainty;
    Kalman1DOutput[0] = KalmanState; Kalman1DOutput[1] = KalmanUncertainty;
}

void reset_all_pid() {  
    pidAngleRoll.reset(); pidAnglePitch.reset();
    pidRateRoll.reset();  pidRatePitch.reset(); pidRateYaw.reset();
}

void pwmsetup() {
    ledc_timer_config_t ledc_timer = {
        .speed_mode = LEDC_HIGH_SPEED_MODE, .duty_resolution = LEDC_TIMER_12_BIT,
        .timer_num = LEDC_TIMER_0, .freq_hz = 250, .clk_cfg = LEDC_AUTO_CLK
    };
    ledc_timer_config(&ledc_timer);
    ledc_channel_config_t ledc_channel[4] = {
        { .gpio_num = PWM_PIN_M1, .speed_mode = LEDC_HIGH_SPEED_MODE, .channel = LEDC_CHANNEL_0, .intr_type = LEDC_INTR_DISABLE, .timer_sel = LEDC_TIMER_0, .duty = 1000, .hpoint = 0 },
        { .gpio_num = PWM_PIN_M2, .speed_mode = LEDC_HIGH_SPEED_MODE, .channel = LEDC_CHANNEL_1, .intr_type = LEDC_INTR_DISABLE, .timer_sel = LEDC_TIMER_0, .duty = 1000, .hpoint = 0 },
        { .gpio_num = PWM_PIN_M3, .speed_mode = LEDC_HIGH_SPEED_MODE, .channel = LEDC_CHANNEL_2, .intr_type = LEDC_INTR_DISABLE, .timer_sel = LEDC_TIMER_0, .duty = 1000, .hpoint = 0 },
        { .gpio_num = PWM_PIN_M4, .speed_mode = LEDC_HIGH_SPEED_MODE, .channel = LEDC_CHANNEL_3, .intr_type = LEDC_INTR_DISABLE, .timer_sel = LEDC_TIMER_0, .duty = 1000, .hpoint = 0 }
    };
    for(int i=0; i<4; i++) ledc_channel_config(&ledc_channel[i]);
}

void fast_pwmwrite(ledc_channel_t channel, int input_val) {
    if(input_val > 4095) input_val = 4095;
    ledc_set_duty(LEDC_HIGH_SPEED_MODE, channel, input_val);
    LEDC.channel_group[0].channel[channel].conf1.duty_start = 1;
}

void gyro_signals() { 
    Wire.beginTransmission(0x68); Wire.write(0x3B); Wire.endTransmission();
    Wire.requestFrom(0x68, 14);
    
    int16_t AccXLSB = Wire.read() << 8 | Wire.read(); int16_t AccYLSB = Wire.read() << 8 | Wire.read();
    int16_t AccZLSB = Wire.read() << 8 | Wire.read(); int16_t TempLSB = Wire.read() << 8 | Wire.read();
    int16_t GyroX   = Wire.read() << 8 | Wire.read(); int16_t GyroY   = Wire.read() << 8 | Wire.read();
    int16_t GyroZ   = Wire.read() << 8 | Wire.read();

    int16_t Mapped_AccX = -AccYLSB; int16_t Mapped_AccY = -AccXLSB; int16_t Mapped_AccZ = AccZLSB;
    int16_t Mapped_GyroX = GyroY;   int16_t Mapped_GyroY = GyroX;   int16_t Mapped_GyroZ = GyroZ;

    const float LPF_FACTOR = 0.15f; 
    static float RateRoll_prev = 0, RatePitch_prev = 0, RateYaw_prev = 0;

    RateRoll  = (RateRoll_prev * (1.0f - LPF_FACTOR)) + (((float)Mapped_GyroX / 65.5f) * LPF_FACTOR);
    RatePitch = (RatePitch_prev * (1.0f - LPF_FACTOR)) + (((float)Mapped_GyroY / 65.5f) * LPF_FACTOR);
    RateYaw   = (RateYaw_prev * (1.0f - LPF_FACTOR)) + (((float)Mapped_GyroZ / 65.5f) * LPF_FACTOR);

    RateRoll_prev = RateRoll; RatePitch_prev = RatePitch; RateYaw_prev = RateYaw;
    
    AccX = (float)Mapped_AccX / 4096.0f - AccXCalibration; 
    AccY = (float)Mapped_AccY / 4096.0f - AccYCalibration; 
    AccZ = (float)Mapped_AccZ / 4096.0f - AccZCalibration; 
    
    AngleRoll  =  atan(AccY / sqrt(AccX*AccX + AccZ*AccZ)) * 57.2957795f;
    AnglePitch = -atan(AccX / sqrt(AccY*AccY + AccZ*AccZ)) * 57.2957795f;
}

void calibrate_sensor() {
    Serial.println("Calibrating Gyro & Accel...");
    RateCalibrationRoll=0; RateCalibrationPitch=0; RateCalibrationYaw=0;
    AccXCalibration=0; AccYCalibration=0; AccZCalibration=0;
    for(int i=0; i<2000; i++) {
        Wire.beginTransmission(0x68); Wire.write(0x3B); Wire.endTransmission();
        Wire.requestFrom(0x68,14);
        int16_t AccXLSB = Wire.read() << 8 | Wire.read(); int16_t AccYLSB = Wire.read() << 8 | Wire.read();
        int16_t AccZLSB = Wire.read() << 8 | Wire.read(); int16_t TempLSB = Wire.read() << 8 | Wire.read();
        int16_t GyroX   = Wire.read() << 8 | Wire.read(); int16_t GyroY   = Wire.read() << 8 | Wire.read();
        int16_t GyroZ   = Wire.read() << 8 | Wire.read();
        
        int16_t Mapped_AccX = -AccYLSB; int16_t Mapped_AccY = -AccXLSB; int16_t Mapped_AccZ = AccZLSB;
        int16_t Mapped_GyroX = GyroY;   int16_t Mapped_GyroY = GyroX;   int16_t Mapped_GyroZ = GyroZ;

        RateCalibrationRoll += (float)Mapped_GyroX / 65.5f; RateCalibrationPitch += (float)Mapped_GyroY / 65.5f;
        RateCalibrationYaw  += (float)Mapped_GyroZ / 65.5f;
        
        AccXCalibration += (float)Mapped_AccX / 4096.0f; AccYCalibration += (float)Mapped_AccY / 4096.0f;
        AccZCalibration += (float)Mapped_AccZ / 4096.0f;
        delay(1);
    }
    RateCalibrationRoll /= 2000.0f; RateCalibrationPitch /= 2000.0f; RateCalibrationYaw /= 2000.0f;
    AccXCalibration /= 2000.0f; AccYCalibration /= 2000.0f; AccZCalibration /= 2000.0f;
    AccZCalibration -= 1.0f; 
}

// ================================================================
// 6. TASKS: FLIGHT CONTROL & TELEMETRY
// ================================================================
void flightControlTask(void *pvParameters) {
    uint32_t prev_inner_time = micros(), prev_outer_time = micros();
    const uint32_t outer_interval_us = 20000; const uint32_t inner_interval_us = 4000;

    while(1) {
        uint32_t current_us = micros();
        uint32_t dt_inner_us = current_us - prev_inner_time;
        
        if (dt_inner_us >= inner_interval_us) {
            float dt_inner = (float)dt_inner_us / 1000000.0f;
            prev_inner_time = current_us;

            gyro_signals(); 
            RateRoll -= RateCalibrationRoll; RatePitch -= RateCalibrationPitch; RateYaw -= RateCalibrationYaw;
            
            kalman_1d(KalmanAngleRoll, KalmanUncertaintyAngleRoll, RateRoll, AngleRoll);
            KalmanAngleRoll = Kalman1DOutput[0]; KalmanUncertaintyAngleRoll = Kalman1DOutput[1];
            kalman_1d(KalmanAnglePitch, KalmanUncertaintyAnglePitch, RatePitch, AnglePitch);
            KalmanAnglePitch = Kalman1DOutput[0]; KalmanUncertaintyAnglePitch = Kalman1DOutput[1];

            uint32_t dt_outer_us = current_us - prev_outer_time;
            if (dt_outer_us >= outer_interval_us) {
                float dt_outer = (float)dt_outer_us / 1000000.0f;
                prev_outer_time = current_us;

                int rawRoll = ReceiverValue[0]; int rawPitch = ReceiverValue[1]; int rawYaw = ReceiverValue[3];
                if (abs(rawRoll - 1500) < 15)  rawRoll  = 1500;
                if (abs(rawPitch - 1500) < 15) rawPitch = 1500;
                if (abs(rawYaw - 1500) < 15)   rawYaw   = 1500;

                float DesiredAngleRoll  = 0.12f * (rawRoll - 1500);
                float DesiredAnglePitch = 0.12f * (rawPitch - 1500);
                DesiredRateYaw          = 0.15f * (rawYaw - 1500);

                DesiredRateRoll  = pidAngleRoll.compute(DesiredAngleRoll - KalmanAngleRoll, dt_outer);
                DesiredRatePitch = pidAnglePitch.compute(DesiredAnglePitch - KalmanAnglePitch, dt_outer);
            }

            float InputRoll  = pidRateRoll.compute(DesiredRateRoll - RateRoll, dt_inner);
            float InputPitch = pidRatePitch.compute(DesiredRatePitch - RatePitch, dt_inner);
            float InputYaw   = pidRateYaw.compute(DesiredRateYaw - RateYaw, dt_inner);

            InputThrottle = constrain(ReceiverValue[2], 1000, 2000);
                
            // --- MIXER MOTOR TELAH DIPERBAIKI (Sesuai Logika: Kanan +, Kiri -) ---
            MotorInput1 = 1.024f * (InputThrottle - InputRoll - InputPitch - InputYaw); // Depan Kanan
            MotorInput2 = 1.024f * (InputThrottle - InputRoll + InputPitch + InputYaw); // Belakang Kanan
            MotorInput3 = 1.024f * (InputThrottle + InputRoll + InputPitch - InputYaw); // Belakang Kiri
            MotorInput4 = 1.024f * (InputThrottle + InputRoll - InputPitch + InputYaw); // Depan Kiri

            MotorInput1 = constrain(MotorInput1, 1100, 1989); MotorInput2 = constrain(MotorInput2, 1100, 1989);
            MotorInput3 = constrain(MotorInput3, 1100, 1989); MotorInput4 = constrain(MotorInput4, 1100, 1989);

            if (InputThrottle < 1080 || abs(KalmanAngleRoll) > 45.0f || abs(KalmanAnglePitch) > 45.0f) { 
                MotorInput1 = 1000; MotorInput2 = 1000; MotorInput3 = 1000; MotorInput4 = 1000;
                reset_all_pid();
            }
            
            fast_pwmwrite(LEDC_CHANNEL_0, MotorInput1); fast_pwmwrite(LEDC_CHANNEL_1, MotorInput2); 
            fast_pwmwrite(LEDC_CHANNEL_2, MotorInput3); fast_pwmwrite(LEDC_CHANNEL_3, MotorInput4);
        }
        vTaskDelay(1 / portTICK_PERIOD_MS);
    }
}

void telemetryTask(void *pvParameters) {
    while(1) {
        myData.msgType  = TELEMETRY_DATA;
        myData.throttle = (int)InputThrottle;
        myData.motor1 = MotorInput1; myData.motor2 = MotorInput2; myData.motor3 = MotorInput3; myData.motor4 = MotorInput4;
        myData.rx1 = ReceiverValue[0]; myData.rx2 = ReceiverValue[1]; myData.rx3 = ReceiverValue[2]; myData.rx4 = ReceiverValue[3];
        myData.roll  = KalmanAngleRoll; myData.pitch = KalmanAnglePitch;
        
        // Ambil nilai Kp, Ki, Kd dari salah satu sumbu (karena disamakan)
        myData.P_Angle = pidAngleRoll.Kp; myData.I_Angle = pidAngleRoll.Ki; myData.D_Angle = pidAngleRoll.Kd;
        myData.P_Rate  = pidRateRoll.Kp;  myData.I_Rate  = pidRateRoll.Ki;  myData.D_Rate  = pidRateRoll.Kd;
        myData.P_Yaw   = pidRateYaw.Kp;   myData.I_Yaw   = pidRateYaw.Ki;   myData.D_Yaw   = pidRateYaw.Kd;
        
        esp_now_send(masterAddress, (uint8_t *)&myData, sizeof(myData));
        vTaskDelay(100 / portTICK_PERIOD_MS); 
    }
}

void setup() {
    Serial.begin(115200); pinMode(2, OUTPUT); 
    WiFi.mode(WIFI_STA);
    WiFi.disconnect();
    if (esp_now_init() != ESP_OK) return;

    esp_now_register_send_cb((esp_now_send_cb_t)OnDataSent); 
    esp_now_register_recv_cb((esp_now_recv_cb_t)OnDataRecv); 
    
    memset(&peerInfo, 0, sizeof(peerInfo)); memcpy(peerInfo.peer_addr, masterAddress, 6);
    peerInfo.channel = 0; peerInfo.encrypt = false; esp_now_add_peer(&peerInfo);
    
    for(int i=0; i<6; i++) { pinMode(channel_pins[i], INPUT_PULLUP); attachInterrupt(digitalPinToInterrupt(channel_pins[i]), channelInterruptHandler, CHANGE); }
    
    Wire.setClock(400000); Wire.begin(); delay(250);
    Wire.beginTransmission(0x68); Wire.write(0x6B); Wire.write(0x00); Wire.endTransmission();
    Wire.beginTransmission(0x68); Wire.write(0x1A); Wire.write(0x03); Wire.endTransmission();
    Wire.beginTransmission(0x68); Wire.write(0x1C); Wire.write(0x10); Wire.endTransmission();
    Wire.beginTransmission(0x68); Wire.write(0x1D); Wire.write(0x03); Wire.endTransmission();
    Wire.beginTransmission(0x68); Wire.write(0x1B); Wire.write(0x08); Wire.endTransmission(); 
    
    calibrate_sensor(); pwmsetup();
    xTaskCreatePinnedToCore(flightControlTask, "FlightCtrl", 8192, NULL, 2, NULL, 1);
    xTaskCreatePinnedToCore(telemetryTask, "Telemetry", 4096, NULL, 1, NULL, 0);
}
void loop() { vTaskDelete(NULL); }

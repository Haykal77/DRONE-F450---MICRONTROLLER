/*
  MASTER CODE - GROUND STATION (Pure CSV Logger, Unified PID, Hardcoded MAC)
*/

#include <esp_now.h>
#include <WiFi.h>

// KUNCI PERMANEN MAC ADDRESS DRONE BARU
uint8_t slaveAddress[] = {0xB0, 0xCB, 0xD8, 0xD7, 0x03, 0xCC};

enum MessageType {
  TELEMETRY_DATA = 1,
  PID_UPDATE     = 2
};

// STRUKTUR PESAN ANTI-PADDING (Sangat Presisi)
typedef struct __attribute__((packed)) struct_message {
  uint8_t msgType; 
  uint8_t padding[3]; 
  
  int throttle;
  int motor1; int motor2; int motor3; int motor4;
  int rx1; int rx2; int rx3; int rx4;
  float roll; float pitch;
  
  float P_Angle, I_Angle, D_Angle;
  float P_Rate, I_Rate, D_Rate;
  float P_Yaw, I_Yaw, D_Yaw;
} struct_message;

struct_message incomingData;
struct_message dataToSend;

volatile bool newData = false;
bool isSynced = false;

// Memori lokal Master
float c_PA=0, c_IA=0, c_DA=0; 
float c_PR=0, c_IR=0, c_DR=0; 
float c_PY=0, c_IY=0, c_DY=0; 

// Fungsi Status Pengiriman
void OnDataSent(const uint8_t *mac_addr, esp_now_send_status_t status) {
  if(status != ESP_NOW_SEND_SUCCESS) {
    Serial.println("# [ERROR] Gagal mengirim paket ke Drone! Cek sinyal/MAC.");
  } else {
    Serial.println("# [SUCCESS] Parameter PID berhasil dikirim!");
  }
}

void OnDataRecv(const esp_now_recv_info_t * info, const uint8_t *data, int len) {
  if (len == sizeof(incomingData)) {
    memcpy(&incomingData, data, sizeof(incomingData));
    if (incomingData.msgType == TELEMETRY_DATA) {
      newData = true;
      // Sinkronisasi memori
      c_PA = incomingData.P_Angle; c_IA = incomingData.I_Angle; c_DA = incomingData.D_Angle;
      c_PR = incomingData.P_Rate;  c_IR = incomingData.I_Rate;  c_DR = incomingData.D_Rate;
      c_PY = incomingData.P_Yaw;   c_IY = incomingData.I_Yaw;   c_DY = incomingData.D_Yaw;
      isSynced = true;
    }
  }
}

void setup() {
  Serial.begin(115200);
  WiFi.mode(WIFI_STA);
  WiFi.disconnect(); // Bersihkan memori radio
  
  if (esp_now_init() != ESP_OK) return;
  
  esp_now_register_send_cb((esp_now_send_cb_t)OnDataSent);
  esp_now_register_recv_cb((esp_now_recv_cb_t)OnDataRecv);
  
  esp_now_peer_info_t peerInfo;
  memset(&peerInfo, 0, sizeof(peerInfo));
  memcpy(peerInfo.peer_addr, slaveAddress, 6);
  peerInfo.channel = 0;  
  peerInfo.encrypt = false;
  peerInfo.ifidx = WIFI_IF_STA;
  
  if (esp_now_add_peer(&peerInfo) == ESP_OK) {
    Serial.println("# [SUCCESS] MAC Address Drone Terkunci Permanen!");
  }
  
  Serial.println("# === GROUND STATION READY (MURNI CSV) ===");
  Serial.println("# COMMANDS: A [P] [I] [D] | R [P] [I] [D] | Y [P] [I] [D]");
  Serial.println("# ========================================================");
  
  // CETAK HEADER UNTUK KOLOM CSV/EXCEL
  Serial.println("Throttle;Roll;Pitch;M1;M2;M3;M4;AP;AI;AD;RP;RI;RD;YP;YI;YD");
}

void loop() {
  if (Serial.available() && isSynced) {
    String input = Serial.readStringUntil('\n');
    input.trim(); input.toUpperCase();
    
    float p, i, d;
    bool sendCommand = false;
    
    // Siapkan buffer dengan data terakhir
    dataToSend.msgType = PID_UPDATE;
    dataToSend.P_Angle = c_PA; dataToSend.I_Angle = c_IA; dataToSend.D_Angle = c_DA;
    dataToSend.P_Rate  = c_PR; dataToSend.I_Rate  = c_IR; dataToSend.D_Rate  = c_DR;
    dataToSend.P_Yaw   = c_PY; dataToSend.I_Yaw   = c_IY; dataToSend.D_Yaw   = c_DY;
    
    if (input.startsWith("A ")) {
      if (sscanf(input.c_str(), "A %f %f %f", &p, &i, &d) == 3) {
        dataToSend.P_Angle = p; dataToSend.I_Angle = i; dataToSend.D_Angle = d; sendCommand = true;
      }
    } else if (input.startsWith("R ")) {
      if (sscanf(input.c_str(), "R %f %f %f", &p, &i, &d) == 3) {
        dataToSend.P_Rate = p; dataToSend.I_Rate = i; dataToSend.D_Rate = d; sendCommand = true;
      }
    } else if (input.startsWith("Y ")) {
      if (sscanf(input.c_str(), "Y %f %f %f", &p, &i, &d) == 3) {
        dataToSend.P_Yaw = p; dataToSend.I_Yaw = i; dataToSend.D_Yaw = d; sendCommand = true;
      }
    }
    
    if (sendCommand) {
      esp_now_send(slaveAddress, (uint8_t *) &dataToSend, sizeof(dataToSend));
    }
  }

  // CETAK MURNI ANGKA (CSV FORMAT)
  if (newData) {
    newData = false;
    
    Serial.printf("%d;%.2f;%.2f;%d;%d;%d;%d;%.3f;%.3f;%.3f;%.3f;%.3f;%.3f;%.3f;%.3f;%.3f\n",
      incomingData.throttle, incomingData.roll, incomingData.pitch,
      incomingData.motor1, incomingData.motor2, incomingData.motor3, incomingData.motor4,
      c_PA, c_IA, c_DA, 
      c_PR, c_IR, c_DR,
      c_PY, c_IY, c_DY
    );
  }
}
